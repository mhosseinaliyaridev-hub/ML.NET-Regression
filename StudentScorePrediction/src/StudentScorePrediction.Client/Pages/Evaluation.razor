@page "/evaluation"
@using StudentScorePrediction.Client.Services
@inject IModelService ModelService

<MudText Typo="Typo.h4" Class="mb-4">ارزیابی و مقایسه مدل‌ها</MudText>

@if (models.Any())
{
    <MudGrid Spacing="4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-4">مقایسه الگوریتم‌ها</MudText>
                
                @if (models.Count > 1)
                {
                    <MudBarChart T="string" 
                                 ChartSeries="[new ChartSeries { Name = \"MAE\", Data = GetMetricData(m => m.Metrics.MAE) }, new ChartSeries { Name = \"RMSE\", Data = GetMetricData(m => m.Metrics.RMSE) }, new ChartSeries { Name = \"R²\", Data = GetMetricData(m => m.Metrics.RSquared * 20) }]"
                                 XAxisLabels="GetModelLabels()"
                                 Height="300px" />
                }
                else
                {
                    <MudAlert Severity="Severity.Info">حداقل دو مدل برای مقایسه نیاز است.</MudAlert>
                }
            </MudPaper>
            
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h6" Class="mb-4">جدول مقایسه</MudText>
                
                <MudSimpleTable Hover="true">
                    <thead>
                        <tr>
                            <th>الگوریتم</th>
                            <th>نسخه</th>
                            <th>MAE</th>
                            <th>MSE</th>
                            <th>RMSE</th>
                            <th>R²</th>
                            <th>زمان آموزش</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var model in models.OrderByDescending(m => m.Metrics.RSquared))
                        {
                            var isBest = model == models.OrderByDescending(m => m.Metrics.RSquared).First();
                            <tr Style="@(isBest ? "background: rgba(76, 175, 80, 0.1);" : "")">
                                <td>
                                    <MudChip T="string" Size="Size.Small" Color="@(GetAlgorithmColor(model.Algorithm))">
                                        @model.Algorithm
                                    </MudChip>
                                    @if (isBest)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Success" Size="Size.Small" Class="ml-1" />
                                    }
                                </td>
                                <td>@model.Version</td>
                                <td>@model.Metrics.MAE.ToString("F4")</td>
                                <td>@model.Metrics.MSE.ToString("F4")</td>
                                <td>@model.Metrics.RMSE.ToString("F4")</td>
                                <td>
                                    @{
                                        var r2Value = model.Metrics.RSquared;
                                        var r2Color = r2Value >= 0.8 ? Color.Success : r2Value >= 0.6 ? Color.Info : Color.Warning;
                                    }
                                    <MudChip T="string" Size="Size.Small" Color="@r2Color">@r2Value.ToString("F3")</MudChip>
                                </td>
                                <td>@model.TrainingDuration.ToString(@"hh\:mm\:ss")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-4">توضیح Metricها</MudText>
                
                <MudExpansionPanels Multi="false" Square="true">
                    <MudExpansionPanel Text="MAE (میانگین خطای مطلق)" Expanded="true">
                        <MudText Typo="Typo.body2">
                            MAE یا Mean Absolute Error میانگین قدر مطلق تفاوت بین مقادیر پیش‌بینی شده و واقعی را نشان می‌دهد.
                            <br/><br/>
                            <strong>فرمول:</strong> MAE = (1/n) × Σ|predicted - actual|
                            <br/><br/>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">هرچه کمتر، بهتر</MudChip>
                            <br/>
                            مقدار ایده‌آل: ۰
                        </MudText>
                    </MudExpansionPanel>
                    
                    <MudExpansionPanel Text="MSE (میانگین مربعات خطا)">
                        <MudText Typo="Typo.body2">
                            MSE یا Mean Squared Error میانگین مربعات تفاوت بین مقادیر پیش‌بینی شده و واقعی است.
                            <br/><br/>
                            <strong>فرمول:</strong> MSE = (1/n) × Σ(predicted - actual)²
                            <br/><br/>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">هرچه کمتر، بهتر</MudChip>
                            <br/>
                            مزیت: جریمه بیشتری برای خطاهای بزرگ اعمال می‌کند.
                        </MudText>
                    </MudExpansionPanel>
                    
                    <MudExpansionPanel Text="RMSE (ریشه میانگین مربعات خطا)">
                        <MudText Typo="Typo.body2">
                            RMSE یا Root Mean Squared Error ریشه دوم MSE است و واحد آن با داده اصلی یکسان است.
                            <br/><br/>
                            <strong>فرمول:</strong> RMSE = √MSE
                            <br/><br/>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">هرچه کمتر، بهتر</MudChip>
                            <br/>
                            تفسیر: اگر RMSE = 1.5 باشد، یعنی به طور متوسط پیش‌بینی‌ها ۱.۵ نمره با واقعیت فاصله دارند.
                        </MudText>
                    </MudExpansionPanel>
                    
                    <MudExpansionPanel Text="R² (ضریب تعیین)">
                        <MudText Typo="Typo.body2">
                            R² یا R-squared نشان می‌دهد که مدل چقدر از تغییرات داده را توضیح می‌دهد.
                            <br/><br/>
                            <strong>محدوده:</strong> ۰ تا ۱ (گاهی منفی)
                            <br/><br/>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">هرچه بیشتر، بهتر</MudChip>
                            <br/>
                            تفسیر:
                            <br/>• R² = ۰.۸ یعنی مدل ۸۰٪ از تغییرات نمرات را توضیح می‌دهد.
                            <br/>• R² = ۱ یعنی مدل کامل است.
                            <br/>• R² منفی یعنی مدل بدتر از میانگین ساده عمل می‌کند.
                        </MudText>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>
            
            @if (bestModel != null)
            {
                <MudPaper Class="pa-4 mt-4" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <MudText Typo="Typo.h6" Class="mb-2">بهترین مدل فعلی</MudText>
                    <MudText Typo="Typo.h5" Class="mb-3">@bestModel.Algorithm</MudText>
                    
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption">R²</MudText>
                            <MudText Typo="Typo.h6">@bestModel.Metrics.RSquared.ToString("F3")</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption">RMSE</MudText>
                            <MudText Typo="Typo.h6">@bestModel.Metrics.RMSE.ToString("F3")</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption">MAE</MudText>
                            <MudText Typo="Typo.h6">@bestModel.Metrics.MAE.ToString("F3")</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption">نسخه</MudText>
                            <MudText Typo="Typo.h6">@bestModel.Version</MudText>
                        </MudItem>
                    </MudGrid>
                    
                    @if (!bestModel.IsActive)
                    {
                        <MudButton Color="Color.Success" OnClick="() => ActivateModel(bestModel.Id)" 
                                   FullWidth="true" Class="mt-4" StartIcon="@Icons.Material.Filled.CheckCircle">
                            فعال‌سازی این مدل
                        </MudButton>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Success" Label="مدل فعال" Class="mt-4" />
                    }
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}
else
{
    <MudPaper Class="pa-4 text-center" Style="min-height: 400px; display: flex; align-items: center; justify-content: center;">
        <div>
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Style="font-size: 80px; opacity: 0.3;" />
            <MudText Typo="Typo.h6" Class="mt-4" Style="opacity: 0.6;">هیچ مدلی برای ارزیابی وجود ندارد.</MudText>
            <MudButton Color="Color.Primary" OnClick="NavigateToTraining" Class="mt-4" StartIcon="@Icons.Material.Filled.AutoAwesome">
                آموزش مدل جدید
            </MudButton>
        </div>
    </MudPaper>
}

@code {
    private List<ModelVersionDto> models = new();
    private ModelVersionDto? bestModel;

    protected override async Task OnInitializedAsync()
    {
        await LoadModelsAsync();
    }

    private async Task LoadModelsAsync()
    {
        try
        {
            models = await ModelService.GetModelsAsync("", null);
            if (models.Any())
            {
                bestModel = models.OrderByDescending(m => m.Metrics.RSquared).FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری مدل‌ها: {ex.Message}", Severity.Error);
        }
    }

    private string[] GetModelLabels()
    {
        return models.Select(m => m.Algorithm).ToArray();
    }

    private double[] GetMetricData(Func<ModelVersionDto, double> selector)
    {
        return models.Select(selector).ToArray();
    }

    private Color GetAlgorithmColor(string algorithm)
    {
        return algorithm switch
        {
            "FastTree" => Color.Primary,
            "FastForest" => Color.Secondary,
            "SDCA" => Color.Tertiary,
            _ => Color.Default
        };
    }

    private async Task ActivateModel(int modelId)
    {
        var confirmed = await DialogService.ShowMessageBox("تأیید فعال‌سازی",
            "آیا مطمئن هستید که می‌خواهید این مدل را فعال کنید؟",
            yesText: "بله", noText: "خیر");
        
        if (confirmed == true)
        {
            try
            {
                await ModelService.ActivateModelAsync(modelId);
                Snackbar.Add("مدل با موفقیت فعال شد!", Severity.Success);
                await LoadModelsAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"خطا: {ex.Message}", Severity.Error);
            }
        }
    }

    private void NavigateToTraining()
    {
        Navigation.NavigateTo("/training");
    }
}
